rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwn(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Koleksi users/{uid}
    match /users/{uid} {
      allow read: if resource.data.uid == uid
            || (resource.data.role == 'guru' && resource.data.isGuru == true);
      allow create: if request.resource.data.uid == uid;
      allow update: if resource.data.uid == uid;
      allow delete: if false;
    }

    // Koleksi names/{key} - mapping nama -> uid
    match /names/{key} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }

    // Koleksi soal_custom/{id} - soal buatan guru
    // Guru bisa baca/tulis, siswa bisa baca
    match /soal_custom/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Koleksi soal_backup/{id} - backup soal
    match /soal_backup/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if true;
    }

    // Koleksi chapter_updates/{id} - tracking bab yang diperbarui
    match /chapter_updates/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Default: tolak semua
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
